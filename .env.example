# Copy to backend/.env and fill in to enable the real integrations.
# All optional: without them the app runs on deterministic fallbacks.

# --- Claude (powers both AI engines) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024

# --- Google Places (venue data) ---
# Absent -> the seeded in-DB venue catalogue is used.
GOOGLE_PLACES_API_KEY=

# --- Storage ---
# Default is local SQLite. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/slowdates
DATABASE_URL=sqlite:///./slowdates.db

# --- Matching tuning ---
MATCH_RADIUS_KM=25
MATCH_SCORE_THRESHOLD=0.55
