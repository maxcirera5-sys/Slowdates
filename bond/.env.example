# BOND environment. Copy to .env.local and fill in to leave DEMO_MODE.
# With ALL of these empty, the app auto-enables DEMO_MODE and runs on mock adapters.

# Force demo mode on/off explicitly ("true"/"false"). Leave unset to auto-detect.
NEXT_PUBLIC_DEMO_MODE=

# --- Supabase (Auth / Postgres / Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for privileged account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (server-side only; never exposed to the browser) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Places (behind a provider abstraction; server-side only) ---
GOOGLE_PLACES_API_KEY=

# --- OAuth (optional; email + demo work without these) ---
# Configure Google in the Supabase dashboard. Apple is a placeholder in the MVP.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
